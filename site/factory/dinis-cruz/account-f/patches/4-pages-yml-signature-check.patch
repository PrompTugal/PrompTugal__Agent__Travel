diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index 1dcf2ff..e8f4dff 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -64,6 +64,8 @@ jobs:
         run: node scripts/test-leak-scan.mjs
       - name: CI check tests (trailer check, leak scan, this workflow)
         run: node scripts/test-ci-checks.mjs
+      - name: Signature check tests
+        run: if [ -e scripts/test-check-signatures.mjs ]; then node scripts/test-check-signatures.mjs; fi
       - if: steps.mode.outputs.deploy == 'true'
         uses: actions/configure-pages@v5
       - if: steps.mode.outputs.deploy == 'true'
@@ -225,11 +227,14 @@ jobs:
           mkdir -p scripts
           # Written over the pushed copies only now that the tree and the disk are known to hold no symlink. A file A
           # lacks is removed, so a pushed exemption or test cannot be used.
-          for f in scripts/check-commits.mjs scripts/leak-scan.mjs scripts/test-leak-scan.mjs scripts/commit-exemptions.json; do
+          for f in scripts/check-commits.mjs scripts/check-signatures.mjs scripts/leak-scan.mjs scripts/test-leak-scan.mjs scripts/commit-exemptions.json; do
             if git cat-file -e "$A:$f" 2>/dev/null; then git show "$A:$f" > "$f"; else rm -f "$f"; fi
           done
           # The bootstrap A has the old checkers: the base's copy runs only on the push that adds the new ones.
           "$NODE_BIN" scripts/check-commits.mjs "$A" "$GITHUB_SHA"
+          # The signature check, from A's copy only (a pushed copy was replaced or removed above). A has none until the push
+          # that brings it, so it first judges the push after that one (cl-6.security's S18 ruling).
+          if [ -e scripts/check-signatures.mjs ]; then "$NODE_BIN" scripts/check-signatures.mjs "$A" "$GITHUB_SHA"; fi
           if [ -e scripts/test-leak-scan.mjs ]; then "$NODE_BIN" scripts/test-leak-scan.mjs; fi
       - name: "Check 8, before the download: nowhere to hide an old artifact"
         if: needs.build.outputs.deploy == 'true'
