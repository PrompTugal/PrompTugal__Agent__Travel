+    t = mkA(true); commit(t.r, 'pushed with its own signature check', { files: { 'scripts/check-signatures.mjs': "console.log('PUSHED-SIG'); process.exit(1);\n" } });
+    env = mkEnv(t.r, { GITHUB_SHA: head(t.r) }); setAnchor(env, t.a);
